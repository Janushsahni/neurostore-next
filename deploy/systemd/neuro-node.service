[Unit]
Description=NeuroStore Node Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neurostore
Group=neurostore
WorkingDirectory=/var/lib/neurostore
ExecStart=/usr/local/bin/neuro-node --setup-config-path /etc/neurostore/node-config.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/neurostore /etc/neurostore
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neuro-node

[Install]
WantedBy=multi-user.target
