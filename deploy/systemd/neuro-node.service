[Unit]
Description=NeuroStore Decentralized Storage Node
After=network-online.target
Wants=network-online.target
Documentation=https://neurostore.vercel.app/docs

[Service]
Type=simple
User=neurostore
Group=neurostore
WorkingDirectory=/var/lib/neurostore
ExecStart=/usr/local/bin/neuro-node --setup-config-path /etc/neurostore/node-config.json
Restart=always
RestartSec=3s
StartLimitBurst=5
StartLimitIntervalSec=60
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/neurostore /etc/neurostore
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neuro-node
Environment=RUST_LOG=info,neuronode=debug

[Install]
WantedBy=multi-user.target
