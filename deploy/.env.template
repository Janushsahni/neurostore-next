# ═══════════════════════════════════════════════════════════════
# NeuroStore Production Environment Template
# Copy this file to .env and fill in all values before deploying.
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=neurostore
POSTGRES_PASSWORD=CHANGE_ME_generate_64_char_secret
POSTGRES_DB=neurostore
DATABASE_URL=postgres://neurostore:CHANGE_ME_generate_64_char_secret@neurostore-db:5432/neurostore

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_generate_redis_password
REDIS_URL=redis://:CHANGE_ME_generate_redis_password@neurostore-redis:6379

# ── Security Secrets (Generate with: openssl rand -hex 32) ────
METADATA_SECRET=CHANGE_ME_generate_a_64_char_hex_secret
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_secret
PROOF_SUBMIT_TOKEN=CHANGE_ME_generate_a_64_char_hex_secret
COMPLIANCE_SIGNING_KEY=CHANGE_ME_generate_a_64_char_hex_secret
MACAROON_SECRET=CHANGE_ME_generate_a_64_char_hex_secret
NODE_SHARED_SECRET=CHANGE_ME_generate_a_64_char_hex_secret

# ── Node Binary Signing (Optional: leave empty to skip) ───────
NODE_BINARY_SIGNING_SECRET=

# ── Environment Mode ──────────────────────────────────────────
ENVIRONMENT=production
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true

# ── Gateway Config ─────────────────────────────────────────────
PORT=9009
RUST_LOG=info
ALLOWED_ORIGINS=https://your-domain.com

# ── Control Plane Config ──────────────────────────────────────
CP_RATE_LIMIT_RPS=120
CP_AUTH_LOCK_THRESHOLD=8
CP_AUTH_LOCK_SECS=300
SESSION_TTL_SECS=86400

# ── OAuth (Optional: Google SSO) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ── Smart Contracts (Base L2) ─────────────────────────────────
NEURO_TOKEN_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT
STORAGE_PAYMENTS_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT
BASE_RPC_URL=https://mainnet.base.org
