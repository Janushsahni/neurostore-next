# ═══════════════════════════════════════════════════════════════
# NeuroStore Sandbox — Demo Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=neurostore
POSTGRES_PASSWORD=sandbox_demo_2026
POSTGRES_DB=neurostore
DATABASE_URL=postgres://neurostore:sandbox_demo_2026@neurostore-db:5432/neurostore

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=sandbox_redis_2026
REDIS_URL=redis://:sandbox_redis_2026@neurostore-redis:6379

# ── Security Secrets (Sandbox-only — NOT for production) ──────
METADATA_SECRET=sandbox_metadata_secret_do_not_use_in_production_12345
JWT_SECRET=sandbox_jwt_secret_do_not_use_in_production_67890abcdef
PROOF_SUBMIT_TOKEN=sandbox_proof_token_not_for_production_use_12345
COMPLIANCE_SIGNING_KEY=sandbox_compliance_key_not_for_production_67890
MACAROON_SECRET=sandbox_macaroon_secret_not_for_production_abcdef12
NODE_SHARED_SECRET=sandbox_node_shared_secret_not_production_fedcba09

# ── Environment Mode ──────────────────────────────────────────
ENVIRONMENT=development
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=true

# ── Gateway Config ─────────────────────────────────────────────
PORT=9009
RUST_LOG=info,neurostore_gateway=debug
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:80

# ── Control Plane Config ──────────────────────────────────────
CP_RATE_LIMIT_RPS=200
CP_AUTH_LOCK_THRESHOLD=20
CP_AUTH_LOCK_SECS=60
SESSION_TTL_SECS=86400

# ── Smart Contracts (Sepolia Testnet) ─────────────────────────
NEURO_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
STORAGE_PAYMENTS_ADDRESS=0x0000000000000000000000000000000000000000
BASE_RPC_URL=https://sepolia.base.org
