<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neurostore.node</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/neuro-node</string>
        <string>--setup-config-path</string>
        <string>/Library/Application Support/NeuroStore/node-config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/NeuroStore</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/neurostore-node.err</string>
    <key>StandardOutPath</key>
    <string>/var/log/neurostore-node.log</string>
</dict>
</plist>
