# Database Configuration
POSTGRES_USER=neuro_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=neurostore_production
DATABASE_URL=postgres://neuro_admin:change-me@neurostore-db:5432/neurostore_production

# Redis Configuration
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@neurostore-redis:6379

# Gateway Secrets
METADATA_SECRET=change-me
JWT_SECRET=change-me
PROOF_SUBMIT_TOKEN=change-me
COMPLIANCE_SIGNING_KEY=change-me

# Control-Plane Secrets
MACAROON_SECRET=change-me
NODE_SHARED_SECRET=change-me
SESSION_TTL_SECS=86400

# Runtime
ENVIRONMENT=production
ALLOWED_ORIGINS=https://app.example.in
RUST_LOG=info,neurostore_gateway=debug
PORT=9009
COOKIE_SECURE=true
FRONTEND_URL=https://app.example.in
TRUST_PROXY_HEADERS=true
ADMIN_API_TOKEN=change-me-admin
NODE_BINARY_SIGNING_SECRET=change-me-node-build-signing
GATEWAY_RATE_LIMIT_RPS=200
CP_RATE_LIMIT_RPS=120
CP_AUTH_LOCK_THRESHOLD=8
CP_AUTH_LOCK_SECS=300
